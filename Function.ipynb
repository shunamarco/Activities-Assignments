      "source": [
        "def student_score_analyzer(x, y, z):\n",
        "    avg = (x + y + z) / 3\n",
        "\n",
        "    if avg >= 90:\n",
        "        print(\"Excellent\")\n",
        "    elif avg >= 75:\n",
        "        print(\"Good\")\n",
        "    else:\n",
        "        print(\"Needs improvement\")\n",
        "\n",
        "    return avg\n",
        "\n",
        "\n",
        "result = student_score_analyzer(85, 90, 80)\n",
        "print(\"Average:\", result)"
      ]
    }
  ]
